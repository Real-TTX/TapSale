@page "{id:long?}"
@model EditModel
@inject TabSale.Web.Services.AppText T
@{ViewData["Title"]=Model.Input.Id==0?T["NewUser"]:Model.Input.DisplayName;}
<div class="page-title"><div><p class="eyebrow">@T["Users"]</p><h1>@ViewData["Title"]</h1></div></div><form method="post" class="panel stack-form"><div asp-validation-summary="ModelOnly" class="validation"></div><input type="hidden" asp-for="Input.Id"/><label asp-for="Input.DisplayName">@T["DisplayName"]</label><input asp-for="Input.DisplayName"/><label asp-for="Input.UserName">@T["UserName"]</label><input asp-for="Input.UserName"/><label asp-for="Input.Password">@(Model.Input.Id==0?T["Password"]:T["NewPassword"])</label><input asp-for="Input.Password"/><label asp-for="Input.Role">@T["Role"]</label><select asp-for="Input.Role" asp-items="Html.GetEnumSelectList<TabSale.Web.Models.UserRole>()"></select><label asp-for="Input.Language">@T["Language"]</label><select asp-for="Input.Language"><option value="en">English</option><option value="de">Deutsch</option></select><label class="check"><input asp-for="Input.IsActive"/> @T["Active"]</label><fieldset><legend>@T["AssignedLists"]</legend>@foreach(var list in Model.SaleLists){<label class="check"><input type="checkbox" name="SelectedLists" value="@list.Id" checked="@Model.SelectedLists.Contains(list.Id)"/> @list.Name</label>}</fieldset><div class="button-row"><button class="btn btn-primary" asp-page-handler="Save">@T["Save"]</button><a class="btn btn-light" asp-page="Index">@T["Back"]</a>@if(Model.CanDelete){<button class="btn btn-danger delete-space" asp-page-handler="Delete" onclick="return confirm('@T["DeleteConfirm"]')">@T["Delete"]</button>}</div></form>
@if(Model.Sessions.Count>0){<section class="panel section-gap"><h2>@T["DeviceSessions"]</h2><div class="table-wrap"><table><thead><tr><th>@T["Device"]</th><th>@T["LastActive"]</th><th>@T["LastSync"]</th><th></th></tr></thead><tbody>@foreach(var s in Model.Sessions){<tr><td>@s.DeviceName</td><td>@s.LastSeenDate.ToLocalTime().ToString("g")</td><td>@s.LastSyncDate?.ToLocalTime().ToString("g")</td><td><form method="post"><button class="btn btn-light" asp-page-handler="Revoke" asp-route-sessionId="@s.Id">@T["Revoke"]</button></form></td></tr>}</tbody></table></div></section>}
