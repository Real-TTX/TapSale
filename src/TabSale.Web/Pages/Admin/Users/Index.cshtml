@page
@model IndexModel
@inject TabSale.Web.Services.AppText T
@{ViewData["Title"]=T["Users"];}
<div class="page-title"><div><p class="eyebrow">@T["Administration"]</p><h1>@T["Users"]</h1></div></div><section class="panel"><form class="toolbar"><input name="search" value="@Request.Query["search"]" placeholder="@T["Search"]…"/><select name="role"><option value="">@T["AllRoles"]</option>@foreach(var r in Enum.GetNames<TabSale.Web.Models.UserRole>()){<option>@r</option>}</select><select name="status"><option value="">@T["AllStatus"]</option><option value="active">@T["Active"]</option><option value="archived">@T["Archived"]</option></select><button class="btn btn-light">⌕ @T["Search"]</button></form><div class="table-wrap"><table><thead><tr><th>@T["Name"]</th><th>@T["UserName"]</th><th>@T["Role"]</th><th>@T["Status"]</th><th></th></tr></thead><tbody>@foreach(var u in Model.Items){<tr><td><strong>@u.DisplayName</strong></td><td>@u.UserName</td><td><span class="badge">@u.Role</span></td><td>@(u.IsActive?T["Active"]:T["Archived"])</td><td><a class="table-link" asp-page="Edit" asp-route-id="@u.Id">@T["Edit"] →</a></td></tr>}</tbody></table></div><div class="list-actions"><a class="btn btn-primary" asp-page="Edit">＋ @T["NewUser"]</a></div></section>
