@page "{id:long?}"
@model EditModel
@inject TabSale.Web.Services.AppText T
@{ViewData["Title"]=Model.Input.Id==0?T["NewProduct"]:Model.Input.Name;}
<div class="page-title"><div><p class="eyebrow">@T["Product"]</p><h1>@ViewData["Title"]</h1></div></div><form method="post" class="panel stack-form"><div asp-validation-summary="ModelOnly" class="validation"></div><input type="hidden" asp-for="Input.Id"/><input type="hidden" asp-for="Input.SaleListId"/><label asp-for="Input.Name">@T["Name"]</label><input asp-for="Input.Name"/><label asp-for="Input.Price">@T["EndPrice"]</label><input asp-for="Input.Price" inputmode="decimal"/><label asp-for="Input.Kind">@T["Type"]</label><select asp-for="Input.Kind" asp-items="Html.GetEnumSelectList<TabSale.Web.Models.ProductKind>()"></select><label asp-for="Input.Color"></label><input asp-for="Input.Color" type="color"/><label asp-for="Input.SortOrder"></label><input asp-for="Input.SortOrder"/><label class="check"><input asp-for="Input.IsActive"/> @T["Active"]</label><div class="button-row"><button class="btn btn-primary" asp-page-handler="Save">@T["Save"]</button><a class="btn btn-light" asp-page="/Admin/SaleLists/Edit" asp-route-id="@Model.Input.SaleListId">@T["Back"]</a>@if(Model.CanDelete){<button class="btn btn-danger delete-space" asp-page-handler="Delete" onclick="return confirm('@T["DeleteConfirm"]')">@T["Delete"]</button>}</div></form>
