@page
@model TabSale.Web.Pages.Admin.Categories.EditModel
@inject TabSale.Web.Services.AppText T
@{ ViewData["Title"] = Model.Input.Id == 0 ? T["NewCategory"] : Model.Input.Name; }
<div class="page-title"><div><p class="eyebrow">@T["Category"]</p><h1>@ViewData["Title"]</h1></div></div>
<form method="post" class="panel stack-form compact-form">
    <div asp-validation-summary="ModelOnly" class="validation"></div><input type="hidden" asp-for="Input.Id"/><input type="hidden" asp-for="Input.SaleListId"/>
    <label asp-for="Input.Name">@T["Name"]</label><input asp-for="Input.Name"/><span asp-validation-for="Input.Name" class="validation"></span>
    <fieldset class="icon-picker"><legend>@T["Icon"]</legend><div class="icon-options">@foreach(var icon in Model.IconOptions){<label class="icon-option"><input type="radio" asp-for="Input.Icon" value="@icon.Key"/><span aria-hidden="true">@icon.Symbol</span><small>@T[icon.TextKey]</small></label>}</div></fieldset>
    <label asp-for="Input.Color">@T["Color"]</label><input asp-for="Input.Color" type="color"/>
    <label asp-for="Input.SortOrder">@T["SortOrder"]</label><input asp-for="Input.SortOrder"/>
    <label class="check"><input asp-for="Input.IsActive"/> @T["Active"]</label>
    <div class="button-row"><button class="btn btn-primary" asp-page-handler="Save">@T["Save"]</button><a class="btn btn-light" asp-page="/Admin/SaleLists/Edit" asp-route-id="@Model.Input.SaleListId" asp-route-tab="categories">@T["Back"]</a>@if(Model.CanDelete){<button class="btn btn-danger delete-space" asp-page-handler="Delete" onclick="return confirm('@T["DeleteConfirm"]')">@T["Delete"]</button>}</div>
</form>
