@page
@model TabSale.Web.Pages.Admin.Categories.IndexModel
@inject TabSale.Web.Services.AppText T
@inject TabSale.Web.Services.CurrentUser Current
@{ ViewData["Title"] = T["Categories"]; }
<div class="page-title"><div><p class="eyebrow">@Model.SaleList.Name</p><h1>@T["Categories"]</h1></div></div>
<section class="panel">
    <form method="get" class="toolbar"><input type="hidden" name="saleListId" value="@Model.SaleList.Id"/><input name="search" value="@Request.Query["search"]" placeholder="@T["Search"]…"/><select name="status"><option value="">@T["AllStatus"]</option><option value="active">@T["Active"]</option><option value="archived">@T["Archived"]</option></select><select name="sort"><option value="order">@T["SortOrder"]</option><option value="name">@T["Name"]</option></select><button class="btn btn-light">⌕ @T["Filter"]</button></form>
    <div class="table-wrap"><table><thead><tr><th>@T["Category"]</th><th>@T["Products"]</th><th>@T["SortOrder"]</th><th>@T["Status"]</th><th></th></tr></thead><tbody>@foreach(var item in Model.Items){var symbol=TabSale.Web.Services.ProductIconCatalog.All.FirstOrDefault(x=>x.Key==item.Icon)?.Symbol??"🏷️";<tr><td><span class="category-mark" style="--category-color:@item.Color">@symbol</span> <strong>@item.Name</strong></td><td>@item.Products.Count</td><td>@item.SortOrder</td><td><span class="badge">@(item.IsActive?T["Active"]:T["Archived"])</span></td><td><a class="table-link" asp-page="Edit" asp-route-id="@item.Id">@T["Edit"] →</a></td></tr>}</tbody></table></div>
    <div class="list-actions"><a class="btn btn-primary" asp-page="Edit" asp-route-saleListId="@Model.SaleList.Id">＋ @T["NewCategory"]</a><a class="btn btn-light" asp-page="/Admin/SaleLists/Edit" asp-route-id="@Model.SaleList.Id">@T["Back"]</a></div>
</section>
