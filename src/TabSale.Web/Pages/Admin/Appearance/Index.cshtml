@page
@model TabSale.Web.Pages.Admin.Appearance.IndexModel
@inject TabSale.Web.Services.AppText T
@{ ViewData["Title"] = T["Appearance"]; }
<div class="page-title"><div><p class="eyebrow">@T["Administration"]</p><h1>@T["Appearance"]</h1></div></div>
@if (Model.Saved) { <div class="success-message">@T["AppearanceSaved"]</div> }
<form method="post" class="panel stack-form appearance-form" id="appearanceForm" data-invalid-color="@T["InvalidHexColor"]">
  <div asp-validation-summary="ModelOnly" class="validation"></div>
  <fieldset class="theme-picker"><legend>@T["ChooseTheme"]</legend><div class="theme-choice-grid">
    <label class="theme-choice theme-choice-classic"><input asp-for="Input.Theme" id="themeClassic" type="radio" value="classic"/><span class="theme-choice-preview"><i></i><i></i><i></i></span><strong>TabSale Classic</strong></label>
    <label class="theme-choice theme-choice-winter"><input asp-for="Input.Theme" id="themeWinter" type="radio" value="winter"/><span class="theme-choice-preview"><i></i><i></i><i></i></span><strong>@T["WinterTheme"]</strong></label>
    <label class="theme-choice theme-choice-market"><input asp-for="Input.Theme" id="themeMarket" type="radio" value="market"/><span class="theme-choice-preview"><i></i><i></i><i></i></span><strong>@T["MarketTheme"]</strong></label>
    <label class="theme-choice theme-choice-contrast"><input asp-for="Input.Theme" id="themeContrast" type="radio" value="contrast"/><span class="theme-choice-preview"><i></i><i></i><i></i></span><strong>@T["ContrastTheme"]</strong></label>
    <label class="theme-choice theme-choice-custom" id="customThemeChoice"><input asp-for="Input.Theme" id="themeCustom" type="radio" value="custom"/><span class="theme-choice-preview"><i></i><i></i><i></i></span><strong>@T["CustomTheme"]</strong></label>
  </div></fieldset>
  <fieldset id="customColors"><legend>@T["CustomColors"]</legend><div class="admin-color-grid">
    <label><span>@T["NavigationColor"]</span><span class="theme-color-control"><input asp-for="Input.Ink" type="color" data-theme-color="--ink"/><input type="text" value="@Model.Input.Ink" data-color-text="--ink" maxlength="7" spellcheck="false" aria-label="@T["NavigationColor"] Hex"/></span></label>
    <label><span>@T["PrimaryColor"]</span><span class="theme-color-control"><input asp-for="Input.Brand" type="color" data-theme-color="--brand"/><input type="text" value="@Model.Input.Brand" data-color-text="--brand" maxlength="7" spellcheck="false" aria-label="@T["PrimaryColor"] Hex"/></span></label>
    <label><span>@T["AccentColor"]</span><span class="theme-color-control"><input asp-for="Input.Lime" type="color" data-theme-color="--lime"/><input type="text" value="@Model.Input.Lime" data-color-text="--lime" maxlength="7" spellcheck="false" aria-label="@T["AccentColor"] Hex"/></span></label>
    <label><span>@T["BackgroundColor"]</span><span class="theme-color-control"><input asp-for="Input.Paper" type="color" data-theme-color="--paper"/><input type="text" value="@Model.Input.Paper" data-color-text="--paper" maxlength="7" spellcheck="false" aria-label="@T["BackgroundColor"] Hex"/></span></label>
    <label><span>@T["DangerColor"]</span><span class="theme-color-control"><input asp-for="Input.Danger" type="color" data-theme-color="--danger"/><input type="text" value="@Model.Input.Danger" data-color-text="--danger" maxlength="7" spellcheck="false" aria-label="@T["DangerColor"] Hex"/></span></label>
  </div><p class="muted">@T["CustomColorsHelp"]</p><button class="btn btn-light" type="button" id="resetThemeColors">@T["ResetColors"]</button></fieldset>
  <section class="theme-live-preview" aria-label="@T["ThemePreview"]">
    <div class="theme-preview-nav"><strong>TabSale</strong><span>@T["Sell"]</span><span>@T["History"]</span></div>
    <div class="theme-preview-content"><small>@T["ThemePreview"]</small><strong>@T["PreviewHeadline"]</strong><div class="theme-preview-card"><span>@T["PreviewProduct"]</span><b>4,50 €</b></div><div class="theme-preview-actions"><span>@T["Save"]</span><span>@T["Delete"]</span></div></div>
  </section>
  <div class="button-row"><button class="btn btn-primary" type="submit">@T["Save"]</button><a class="btn btn-light" asp-page="/Sale/Index">@T["Back"]</a></div>
</form>

@section Scripts { <script src="~/js/appearance.js" asp-append-version="true"></script> }
