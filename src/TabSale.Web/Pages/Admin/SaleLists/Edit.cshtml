@page "{id:long?}"
@model EditModel
@inject TabSale.Web.Services.CurrentUser Current
@inject TabSale.Web.Services.AppText T
@{ ViewData["Title"] = Model.Input.Id == 0 ? T["NewSaleList"] : Model.Input.Name; }
<div class="page-title"><div><p class="eyebrow">@T["SaleLists"]</p><h1>@ViewData["Title"]</h1></div></div>
<form method="post" class="panel stack-form"><div asp-validation-summary="ModelOnly" class="validation"></div><input type="hidden" asp-for="Input.Id"/><label asp-for="Input.Name">@T["Name"]</label><input asp-for="Input.Name"/><label class="check"><input asp-for="Input.IsActive"/> @T["Active"]</label>
<div class="button-row"><button class="btn btn-primary" asp-page-handler="Save">@T["Save"]</button><a class="btn btn-light" asp-page="Index">@T["Back"]</a>@if(Model.CanDelete){<button class="btn btn-danger delete-space" asp-page-handler="Delete" onclick="return confirm('@T["DeleteConfirm"]')">@T["Delete"]</button>}</div></form>
@if(Model.Input.Id != 0){
<section class="panel section-gap">
    <div class="section-title"><h2>@T["Products"]</h2><div class="inline-actions"><a class="btn btn-light" asp-page="/Admin/Categories/Index" asp-route-saleListId="@Model.Input.Id">▦ @T["Categories"]</a><a class="btn btn-primary" asp-page="/Admin/Products/Edit" asp-route-saleListId="@Model.Input.Id">＋ @T["Product"]</a></div></div>
    <div class="table-wrap"><table><thead><tr><th>@T["Product"]</th><th>@T["Category"]</th><th>@T["Price"]</th><th>@T["Type"]</th><th>@T["Status"]</th><th></th></tr></thead><tbody>
    @foreach(var product in Model.Products){var symbol=TabSale.Web.Services.ProductIconCatalog.All.FirstOrDefault(x=>x.Key==product.Icon)?.Symbol??"🏷️";<tr><td><span class="product-table-visual">@if(product.ImagePath is not null){<img src="/uploads/@product.ImagePath" alt=""/>}else{@symbol}</span><strong>@product.Name</strong></td><td>@(product.ProductCategory?.Name??T["NoCategory"])</td><td>@((product.UnitPriceCents/100m).ToString("C"))</td><td>@product.Kind</td><td><span class="badge">@(product.IsActive?T["Active"]:T["Archived"])</span></td><td><a class="table-link" asp-page="/Admin/Products/Edit" asp-route-id="@product.Id">@T["Edit"] →</a></td></tr>}
    </tbody></table></div>
</section>}
