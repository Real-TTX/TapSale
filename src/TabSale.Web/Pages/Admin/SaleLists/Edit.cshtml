@page "{id:long?}"
@model EditModel
@inject TabSale.Web.Services.CurrentUser Current
@inject TabSale.Web.Services.AppText T
@{ ViewData["Title"] = Model.Input.Id == 0 ? T["NewSaleList"] : Model.Input.Name; }
<div class="page-title"><div><p class="eyebrow">@T["SaleLists"]</p><h1>@ViewData["Title"]</h1></div></div>
<form method="post" class="panel stack-form"><div asp-validation-summary="ModelOnly" class="validation"></div><input type="hidden" asp-for="Input.Id"/><label asp-for="Input.Name">@T["Name"]</label><input asp-for="Input.Name"/><label asp-for="Input.CategoryDisplayMode">@T["CategoryDisplay"]</label><select asp-for="Input.CategoryDisplayMode"><option value="Filter">@T["CategoryFilterMode"]</option><option value="Sections">@T["CategorySectionsMode"]</option><option value="Drilldown">@T["CategoryDrilldownMode"]</option></select><label class="check"><input asp-for="Input.IsActive"/> @T["Active"]</label>
<div class="button-row"><button class="btn btn-primary" asp-page-handler="Save">@T["Save"]</button><a class="btn btn-light" asp-page="Index">@T["Back"]</a>@if(Model.CanDelete){<button class="btn btn-danger delete-space" asp-page-handler="Delete" onclick="return confirm('@T["DeleteConfirm"]')">@T["Delete"]</button>}</div></form>
@if(Model.Input.Id != 0){
<section class="panel section-gap">
    <nav class="tab-bar" aria-label="@T["SaleListContent"]"><a class="@(Model.ActiveTab=="products"?"active":"")" asp-page="Edit" asp-route-id="@Model.Input.Id" asp-route-tab="products">▦ @T["ProductList"] <span>@Model.ProductCount</span></a><a class="@(Model.ActiveTab=="categories"?"active":"")" asp-page="Edit" asp-route-id="@Model.Input.Id" asp-route-tab="categories">◫ @T["Categories"] <span>@Model.CategoryCount</span></a></nav>
    @if(Model.ActiveTab=="products"){
        <form method="get" class="toolbar"><input type="hidden" name="id" value="@Model.Input.Id"/><input type="hidden" name="tab" value="products"/><input name="productSearch" value="@Request.Query["productSearch"]" placeholder="@T["Search"]…"/><select name="productStatus"><option value="">@T["AllStatus"]</option><option value="active" selected="@(Request.Query["productStatus"]=="active")">@T["Active"]</option><option value="archived" selected="@(Request.Query["productStatus"]=="archived")">@T["Archived"]</option></select><button class="btn btn-light">⌕ @T["Filter"]</button></form>
        <div class="table-wrap"><table><thead><tr><th>@T["Product"]</th><th>@T["Category"]</th><th>@T["Price"]</th><th>@T["Type"]</th><th>@T["Status"]</th><th></th></tr></thead><tbody>
        @foreach(var product in Model.Products){var symbol=TabSale.Web.Services.ProductIconCatalog.All.FirstOrDefault(x=>x.Key==product.Icon)?.Symbol??"🏷️";<tr><td><span class="product-table-visual">@if(product.ImagePath is not null){<img src="/uploads/@product.ImagePath" alt=""/>}else{@symbol}</span><strong>@product.Name</strong></td><td>@(product.ProductCategory?.Name??T["NoCategory"])</td><td>@((product.UnitPriceCents/100m).ToString("C"))</td><td>@product.Kind</td><td><span class="badge">@(product.IsActive?T["Active"]:T["Archived"])</span></td><td><a class="table-link" asp-page="/Admin/Products/Edit" asp-route-id="@product.Id">@T["Edit"] →</a></td></tr>}
        </tbody></table></div><div class="list-actions"><a class="btn btn-primary" asp-page="/Admin/Products/Edit" asp-route-saleListId="@Model.Input.Id">＋ @T["NewProduct"]</a></div>
    }else{
        <form method="get" class="toolbar"><input type="hidden" name="id" value="@Model.Input.Id"/><input type="hidden" name="tab" value="categories"/><input name="categorySearch" value="@Request.Query["categorySearch"]" placeholder="@T["Search"]…"/><select name="categoryStatus"><option value="">@T["AllStatus"]</option><option value="active" selected="@(Request.Query["categoryStatus"]=="active")">@T["Active"]</option><option value="archived" selected="@(Request.Query["categoryStatus"]=="archived")">@T["Archived"]</option></select><button class="btn btn-light">⌕ @T["Filter"]</button></form>
        <div class="table-wrap"><table><thead><tr><th>@T["Category"]</th><th>@T["Products"]</th><th>@T["SortOrder"]</th><th>@T["Status"]</th><th></th></tr></thead><tbody>
        @foreach(var category in Model.Categories){var symbol=TabSale.Web.Services.ProductIconCatalog.All.FirstOrDefault(x=>x.Key==category.Icon)?.Symbol??"🏷️";<tr><td><span class="category-mark" style="--category-color:@category.Color">@symbol</span><strong>@category.Name</strong></td><td>@category.Products.Count</td><td>@category.SortOrder</td><td><span class="badge">@(category.IsActive?T["Active"]:T["Archived"])</span></td><td><a class="table-link" asp-page="/Admin/Categories/Edit" asp-route-id="@category.Id">@T["Edit"] →</a></td></tr>}
        </tbody></table></div><div class="list-actions"><a class="btn btn-primary" asp-page="/Admin/Categories/Edit" asp-route-saleListId="@Model.Input.Id">＋ @T["NewCategory"]</a></div>
    }
</section>}
