@page
@model IndexModel
@inject TabSale.Web.Services.AppText T
@{ ViewData["Title"] = T["SaleLists"]; }
<div class="page-title"><div><p class="eyebrow">@T["Administration"]</p><h1>@T["SaleLists"]</h1></div></div>
<section class="panel"><form method="get" class="toolbar"><input name="search" value="@Request.Query["search"]" placeholder="@T["Search"]…"/><select name="status"><option value="">@T["AllStatus"]</option><option value="active">@T["Active"]</option><option value="archived">@T["Archived"]</option></select><button class="btn btn-light">⌕ @T["Search"]</button></form>
<div class="table-wrap"><table><thead><tr><th>@T["Name"]</th><th>@T["Products"]</th><th>@T["Status"]</th><th></th></tr></thead><tbody>
@foreach(var item in Model.Items){<tr><td><strong>@item.Name</strong></td><td>@item.Products.Count</td><td><span class="badge">@(item.IsActive?T["Active"]:T["Archived"])</span></td><td><a class="table-link" asp-page="Edit" asp-route-id="@item.Id">@T["Edit"] →</a></td></tr>}
</tbody></table></div><div class="list-actions"><a class="btn btn-primary" asp-page="Edit">＋ @T["NewSaleList"]</a></div></section>
