@page
@model SetupModel
@inject TabSale.Web.Services.AppText T
@{ ViewData["Title"] = T["Setup"]; Layout = "_AuthLayout"; }
<div class="auth-card">
    <div class="brand-mark">TS</div><p class="eyebrow">TABSALE</p><h1>@T["Setup"]</h1>
    <p class="muted">@T["SetupHelp"]</p>
    <form method="post" class="stack-form">
        <div asp-validation-summary="ModelOnly" class="validation"></div>
        <label asp-for="Input.DisplayName">@T["DisplayName"]</label><input asp-for="Input.DisplayName" autocomplete="name" />
        <label asp-for="Input.UserName">@T["UserName"]</label><input asp-for="Input.UserName" autocomplete="username" />
        <label asp-for="Input.Password">@T["Password"]</label><input asp-for="Input.Password" autocomplete="new-password" />
        <label asp-for="Input.Language">@T["Language"]</label><select asp-for="Input.Language"><option value="en">English</option><option value="de">Deutsch</option></select>
        <button class="btn btn-primary btn-large" type="submit">@T["Save"]</button>
    </form>
</div>
