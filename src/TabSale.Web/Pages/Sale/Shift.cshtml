@page
@model ShiftModel
@inject TabSale.Web.Services.AppText T
@{ViewData["Title"]=T["CashShift"];}
<div class="page-title"><div><p class="eyebrow">@T["Optional"]</p><h1>@T["CashShift"]</h1></div></div><section class="panel"><form method="get" class="toolbar"><select name="saleListId" onchange="this.form.submit()">@foreach(var l in Model.Lists){<option value="@l.Id" selected="@(l.Id==Model.SaleListId)">@l.Name</option>}</select></form>
@if(Model.Active is null){<div class="empty-state inline-empty"><h2>@T["NoActiveShift"]</h2><p>@T["NoShiftHelp"]</p><form method="post" class="stack-form compact"><input type="hidden" asp-for="SaleListId"/><label asp-for="Amount">@T["OpeningBalance"]</label><input asp-for="Amount" inputmode="decimal"/><div class="button-row"><button class="btn btn-primary" asp-page-handler="Open">@T["StartShift"]</button><a class="btn btn-light" asp-page="Index" asp-route-listId="@Model.SaleListId">@T["Back"]</a></div></form></div>}
else{<div class="stat-row"><div class="stat"><small>@T["OpeningBalance"]</small><strong>@((Model.Active.OpeningCents/100m).ToString("C"))</strong></div><div class="stat"><small>@T["ExpectedCash"]</small><strong>@((Model.ExpectedCents/100m).ToString("C"))</strong></div></div><form method="post" class="stack-form compact"><input type="hidden" asp-for="SaleListId"/><label asp-for="Amount">@T["CountedCash"]</label><input asp-for="Amount" inputmode="decimal"/><div class="button-row"><button class="btn btn-primary" asp-page-handler="Close" asp-route-id="@Model.Active.Id">@T["CloseShift"]</button><a class="btn btn-light" asp-page="Index" asp-route-listId="@Model.SaleListId">@T["Back"]</a></div></form>}</section>
