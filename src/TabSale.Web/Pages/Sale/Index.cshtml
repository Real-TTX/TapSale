@page
@model TabSale.Web.Pages.Sale.IndexModel
@inject TabSale.Web.Services.AppText T
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{ ViewData["Title"] = T["Sell"]; var token = Antiforgery.GetAndStoreTokens(HttpContext).RequestToken; var activeList = Model.Lists.FirstOrDefault(x => x.Id == Model.ActiveListId); }
<meta name="csrf-token" content="@token" />
<div id="saleApp" data-active-list="@Model.ActiveListId" data-user-id="@Model.UserId" data-ready="@T["Ready"]" data-pending="@T["Pending"]" data-synced="@T["Synced"]" data-all-categories="@T["AllCategories"]" data-other-category="@T["OtherCategory"]" data-back-categories="@T["BackToCategories"]" data-order="@T["Order"]" data-empty-order="@T["EmptyOrder"]" data-item="@T["Item"]" data-items="@T["Items"]" data-reset-cart-confirm="@T["ResetCartConfirm"]">
    <div class="sale-head">
        <div><p class="eyebrow"><a id="cashShiftLink" asp-page="Shift" asp-route-saleListId="@Model.ActiveListId">◴ @T["CashShift"]</a></p><button type="button" id="saleListOpen" class="list-switch" aria-haspopup="dialog" aria-controls="saleListDialog" disabled="@(activeList is null)"><span id="saleListName">@(activeList?.Name ?? T["NoList"])</span><b aria-hidden="true"><svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg></b></button></div>
        <div class="sale-controls"><div class="view-switch" role="group"><button type="button" data-view="tiles" class="active"><span>@T["TileMode"]</span></button><button type="button" data-view="list"><span>@T["ListMode"]</span></button></div><button type="button" id="restaurantToggle" class="restaurant-toggle" aria-pressed="false" title="@T["RestaurantModeHelp"]"><span>@T["RestaurantMode"]</span></button></div>
    </div>
    <div class="sale-workspace">
        <section class="catalog-pane">
            <section class="total-display"><span>@T["Total"]</span><strong id="topTotal">€0.00</strong><small id="syncState">● <span>@T["Ready"]</span></small><button type="button" class="cart-reset cart-reset-standard" data-reset-cart disabled aria-label="@T["ResetCart"]"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M4 7h16M9 7V4h6v3m-9 0 1 13h10l1-13M10 11v5m4-5v5"/></svg><span>@T["ResetCartShort"]</span></button></section>
            <nav id="categoryFilter" class="category-filter" aria-label="@T["Categories"]" hidden></nav>
            @if (Model.Lists.Count == 0) { <div class="empty-state"><strong>@T["NoList"]</strong><p>@T["NoListHelp"]</p></div> }
            <div id="productGrid" class="product-grid tiles"></div>
        </section>
        <aside class="order-panel" aria-label="@T["Order"]">
            <header class="order-panel-head"><div><p class="eyebrow">@T["CurrentOrder"]</p><h2>@T["Order"]</h2></div><div class="order-panel-actions"><span id="orderCount" class="badge">0 @T["Items"]</span><button type="button" class="cart-reset cart-reset-order" data-reset-cart disabled aria-label="@T["ResetCart"]"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M4 7h16M9 7V4h6v3m-9 0 1 13h10l1-13M10 11v5m4-5v5"/></svg><span>@T["ResetCartShort"]</span></button></div></header>
            <div id="orderLines" class="order-lines"><p class="order-empty">@T["EmptyOrder"]</p></div>
            <div class="order-total"><span>@T["Total"]</span><strong id="orderTotal">€0.00</strong></div>
            <button type="button" id="payBar" class="pay-bar" disabled><span><small>@T["Pay"]</small><strong id="bottomTotal">€0.00</strong></span><b>→</b></button>
        </aside>
    </div>
</div>
<dialog id="saleListDialog" class="sale-list-dialog" aria-labelledby="saleListDialogTitle">
 <form method="dialog"><button class="dialog-close" value="cancel" aria-label="@T["Close"]">×</button></form>
 <header class="list-picker-head"><p class="eyebrow">@T["SaleLists"]</p><h2 id="saleListDialogTitle">@T["ChooseSaleList"]</h2></header>
 <div class="sale-list-options">
 @foreach (var list in Model.Lists) { <button type="button" class="sale-list-option @(list.Id == Model.ActiveListId ? "active" : "")" data-list-id="@list.Id" aria-pressed="@(list.Id == Model.ActiveListId ? "true" : "false")"><strong>@list.Name</strong><b aria-hidden="true">@(list.Id == Model.ActiveListId ? "✓" : "→")</b></button> }
 </div>
</dialog>
<dialog id="paymentDialog" class="payment-dialog">
 <form method="dialog"><button class="dialog-close" value="cancel" aria-label="@T["Close"]">×</button></form>
 <section id="paymentReceipt" class="payment-receipt">
  <div class="payment-receipt-head"><strong>@T["Order"]</strong><span id="paymentItemCount">0 @T["Items"]</span></div>
  <button type="button" id="paymentReceiptToggle" class="payment-receipt-toggle" aria-expanded="false" aria-controls="paymentReceiptOverlay"><strong id="paymentReceiptToggleCount">0 @T["Items"]</strong><span>@T["ShowOrderDetails"]</span><b aria-hidden="true">↑</b></button>
  <div id="paymentLines" class="payment-lines"></div>
 </section>
 <section id="paymentReceiptOverlay" class="payment-receipt-overlay" hidden aria-labelledby="paymentReceiptOverlayTitle">
  <header><div><p class="eyebrow">@T["CurrentOrder"]</p><h2 id="paymentReceiptOverlayTitle">@T["Order"]</h2></div><button type="button" id="paymentReceiptClose" class="dialog-close" aria-label="@T["CloseOrderDetails"]">×</button></header>
  <div id="paymentOverlayLines" class="payment-lines payment-overlay-lines"></div>
  <button type="button" id="paymentReceiptBack" class="btn btn-secondary payment-receipt-back">← @T["BackToPayment"]</button>
 </section>
 <div id="paymentNormal"><p class="eyebrow">@T["Cash"]</p><h2 id="dueTotal">€0.00</h2><p id="givenLabel" class="given-label">@T["Given"]</p><div class="given-display"><span class="given-input-wrap"><input id="givenInput" class="given-input" type="text" inputmode="decimal" enterkeyhint="done" autocomplete="off" readonly aria-labelledby="givenLabel" value="€0.00"/><small class="system-keyboard-hint">@T["TapToEnterAmount"]</small></span><button type="button" id="clearGiven" class="given-clear" aria-label="@T["ResetGiven"]">×</button></div>
 <div class="quick-cash"><button type="button" data-cash="500">€5</button><button type="button" data-cash="1000">€10</button><button type="button" data-cash="2000">€20</button><button type="button" data-cash="5000">€50</button></div>
 <div class="keypad">@foreach (var key in new[]{"1","2","3","4","5","6","7","8","9","C","0","⌫"}) { <button type="button" data-key="@key">@key</button> }</div></div>
 <div id="paymentPayout" hidden><p class="eyebrow">@T["Payout"]</p><h2 id="payoutTotal">€0.00</h2><p>@T["ConfirmPayout"]</p></div>
 <footer class="payment-actions"><div id="paymentChange" class="change-box"><span>@T["Change"]</span><strong id="changeTotal" aria-live="polite">€0.00</strong></div><button type="button" id="completeSale" class="btn btn-primary btn-complete" disabled>@T["Complete"]</button></footer>
</dialog>
<script id="catalogData" type="application/json">@Html.Raw(Model.CatalogJson)</script>
@section Scripts { <script src="~/js/sale.js" asp-append-version="true"></script> }
