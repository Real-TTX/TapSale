@page "{id:long}"
@model DetailsModel
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@inject TabSale.Web.Services.AppText T
@{ViewData["Title"]=T["Receipt"];var token=Antiforgery.GetAndStoreTokens(HttpContext).RequestToken;}
<meta name="csrf-token" content="@token"/><div class="page-title"><div><p class="eyebrow">@T["Receipt"] @Model.Item.Token.ToString()[..8]</p><h1>@((Model.Item.TotalCents/100m).ToString("C"))</h1></div></div><section class="panel receipt-meta"><div><small>@T["Sold"]</small><strong>@Model.Item.SoldDate.ToLocalTime().ToString("G")</strong></div><div><small>@T["Users"]</small><strong>@Model.Item.User.DisplayName</strong></div><div><small>@T["SaleLists"]</small><strong>@Model.Item.SaleList.Name</strong></div><div><small>@T["ShiftName"]</small><strong>@(Model.Item.CashShift?.Name ?? "—")</strong></div></section><section class="panel section-gap"><div class="table-wrap"><table><thead><tr><th>@T["Product"]</th><th>@T["Type"]</th><th>@T["Quantity"]</th><th class="right">@T["Price"]</th><th class="right">@T["Total"]</th></tr></thead><tbody>@foreach(var l in Model.Item.Lines){<tr><td>@l.ProductName</td><td>@l.ProductKind</td><td>@l.Quantity</td><td class="right">@((l.UnitPriceCents/100m).ToString("C"))</td><td class="right">@((l.LineTotalCents/100m).ToString("C"))</td></tr>}</tbody></table></div><div class="button-row"><a class="btn btn-light" asp-page="Index">@T["Back"]</a>@if(Model.CanCancel){<button type="button" class="btn btn-danger delete-space" id="cancelSale">@T["CancelSale"]</button>}</div></section>
@section Scripts{<script>document.getElementById('cancelSale')?.addEventListener('click',async()=>{if(!confirm('Create an auditable cancellation?'))return;const r=await fetch('/api/sales/@Model.Item.Id/cancel',{method:'POST',headers:{'X-CSRF-TOKEN':document.querySelector('meta[name="csrf-token"]').content}});if(r.ok)location.href='/History';else alert(await r.text());});</script>}
