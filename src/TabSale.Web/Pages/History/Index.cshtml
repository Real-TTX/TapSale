@page
@model IndexModel
@inject TabSale.Web.Services.CurrentUser Current
@inject TabSale.Web.Services.AppText T
@{ViewData["Title"]=T["History"];}
<div class="page-title"><div><p class="eyebrow">@T["Reports"]</p><h1>@(Current.Role==TabSale.Web.Models.UserRole.User?T["MySales"]:T["History"])</h1></div><a class="btn btn-light" asp-page="/Sale/Shift">◴ @T["CashShift"]</a></div><div class="stat-row"><div class="stat"><small>@T["Result"]</small><strong>@((Model.RevenueCents/100m).ToString("C"))</strong></div><div class="stat"><small>@T["Transactions"]</small><strong>@Model.SaleCount</strong></div></div>
<section class="panel"><form method="get" class="toolbar"><input type="date" name="from" value="@Request.Query["from"]"/><input type="date" name="to" value="@Request.Query["to"]"/><select name="saleListId"><option value="">@T["AllSaleLists"]</option>@foreach(var l in Model.Lists){<option value="@l.Id" selected="@(Request.Query["saleListId"]==l.Id.ToString())">@l.Name</option>}</select><input name="search" value="@Request.Query["search"]" placeholder="@T["Search"]…"/><button class="btn btn-light">@T["Filter"]</button></form><div class="table-wrap"><table><thead><tr><th>@T["Time"]</th><th>@T["Receipt"]</th><th>@T["Users"]</th><th>@T["SaleLists"]</th><th>@T["Type"]</th><th class="right">@T["Total"]</th><th></th></tr></thead><tbody>@foreach(var s in Model.Items){<tr><td>@s.SoldDate.ToLocalTime().ToString("g")</td><td><code>@s.Token.ToString()[..8]</code></td><td>@s.User.DisplayName</td><td>@s.SaleList.Name</td><td><span class="badge">@s.Kind</span></td><td class="right amount @(s.TotalCents<0?"negative":"")">@((s.TotalCents/100m).ToString("C"))</td><td><a class="table-link" asp-page="Details" asp-route-id="@s.Id">@T["Details"] →</a></td></tr>}</tbody></table></div><nav class="pagination">@for(var p=1;p<=Model.TotalPages;p++){<a class="@(p==Model.PageNumber?"active":"")" asp-route-pageNumber="@p" asp-route-from="@Request.Query["from"]" asp-route-to="@Request.Query["to"]" asp-route-saleListId="@Request.Query["saleListId"]" asp-route-search="@Request.Query["search"]">@p</a>}</nav><div class="list-actions"><a id="exportCsv" class="btn btn-primary" asp-page-handler="Export" asp-route-from="@Request.Query["from"]" asp-route-to="@Request.Query["to"]" asp-route-saleListId="@Request.Query["saleListId"]" asp-route-search="@Request.Query["search"]">⇩ @T["ExportCsv"]</a><button type="button" id="shareCsv" class="btn btn-light">↗ @T["Share"]</button></div></section>
@section Scripts{<script>document.getElementById('shareCsv')?.addEventListener('click',async()=>{const link=document.getElementById('exportCsv');try{const response=await fetch(link.href),blob=await response.blob(),file=new File([blob],'tabsale.csv',{type:'text/csv'});if(navigator.canShare?.({files:[file]}))await navigator.share({title:'TabSale export',files:[file]});else link.click();}catch{link.click();}});</script>}
