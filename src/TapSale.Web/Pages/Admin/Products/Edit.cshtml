@page
@model TapSale.Web.Pages.Admin.Products.EditModel
@inject TapSale.Web.Services.AppText T
@{ ViewData["Title"] = Model.Input.Id == 0 ? T["NewProduct"] : Model.Input.Name; }
<div class="page-title"><div><p class="eyebrow">@T["Product"]</p><h1>@ViewData["Title"]</h1></div></div>
<form method="post" enctype="multipart/form-data" class="panel stack-form">
    <div asp-validation-summary="ModelOnly" class="validation"></div>
    <input type="hidden" asp-for="Input.Id"/><input type="hidden" asp-for="Input.SaleListId"/>
    <label asp-for="Input.Name">@T["Name"]</label><input asp-for="Input.Name"/>
    <label asp-for="Input.Price">@T["EndPrice"]</label><input asp-for="Input.Price" inputmode="decimal"/>
    <label asp-for="Input.Kind">@T["Type"]</label><select asp-for="Input.Kind" asp-items="Html.GetEnumSelectList<TapSale.Web.Models.ProductKind>()"></select>
    <label asp-for="Input.ProductCategoryId">@T["Category"]</label>
    <select asp-for="Input.ProductCategoryId"><option value="">@T["NoCategory"]</option>@foreach(var category in Model.Categories){<option value="@category.Id">@category.Name@(!category.IsActive ? $" ({T["Archived"]})" : "")</option>}</select>
    <label asp-for="Input.Image">@T["ProductImage"]</label>
    @if(Model.CurrentImagePath is not null){<div class="image-preview"><img src="/uploads/@Model.CurrentImagePath" alt=""/><label class="check"><input asp-for="Input.RemoveImage"/> @T["RemoveImage"]</label></div>}
    <input asp-for="Input.Image" type="file" accept="image/png,image/jpeg,image/gif,image/webp"/><span asp-validation-for="Input.Image" class="validation"></span><small class="muted">@T["ImageHelp"]</small>
    <fieldset class="icon-picker"><legend>@T["FallbackIcon"]</legend><div class="icon-options">@foreach(var icon in Model.IconOptions){<label class="icon-option"><input type="radio" asp-for="Input.Icon" value="@icon.Key"/><span aria-hidden="true">@icon.Symbol</span><small>@T[icon.TextKey]</small></label>}</div></fieldset>
    <label asp-for="Input.Color">@T["Color"]</label><input asp-for="Input.Color" type="color"/>
    <label asp-for="Input.SortOrder">@T["SortOrder"]</label><input asp-for="Input.SortOrder"/>
    <label class="check"><input asp-for="Input.IsActive"/> @T["Active"]</label>
    <div class="button-row"><button class="btn btn-primary" asp-page-handler="Save">@T["Save"]</button><a class="btn btn-light" asp-page="/Admin/SaleLists/Edit" asp-route-id="@Model.Input.SaleListId">@T["Back"]</a>@if(Model.CanDelete){<button class="btn btn-danger delete-space" asp-page-handler="Delete" data-confirm="@T["DeleteConfirm"]" data-confirm-title="@T["Confirmation"]" data-confirm-action="@T["Delete"]">@T["Delete"]</button>}</div>
</form>
