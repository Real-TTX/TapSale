@inject TapSale.Web.Services.AppText T
@inject TapSale.Web.Services.CurrentUser Current
@inject TapSale.Web.Services.ThemeConfigStore ThemeStore
@{ var theme = ThemeStore.Current; var themeStyle = theme.Theme == "custom" ? $"--ink:{theme.Ink};--brand:{theme.Brand};--lime:{theme.Lime};--paper:{theme.Paper};--danger:{theme.Danger}" : ""; }
<!DOCTYPE html><html lang="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName" data-theme="@theme.Theme" style="@themeStyle"><head>
<meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"/><meta name="theme-color" content="#102A2A"/><meta name="apple-mobile-web-app-capable" content="yes"/><style>html{font-family:system-ui,-apple-system,"Segoe UI",sans-serif}button,input,select,textarea{font:inherit}</style>
<title>@ViewData["Title"] · TapSale</title><link rel="icon" type="image/svg+xml" href="~/icons/app-icon.svg"/><link rel="icon" href="~/favicon.ico" sizes="16x16 32x32 48x48"/><link rel="apple-touch-icon" href="~/icons/app-icon-192.png"/><link rel="manifest" href="~/manifest.webmanifest"/><script>try{if((localStorage.getItem('tapsaleSidebarCollapsed')??localStorage.getItem('tabsaleSidebarCollapsed'))==='true')document.documentElement.classList.add('sidebar-collapsed')}catch{}</script><link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
</head><body><div class="app-shell">
<aside class="sidebar" id="sidebar"><div class="sidebar-head"><a class="logo" asp-page="/Sale/Index"><img class="logo-mark" src="~/icons/app-icon.svg" alt=""/><strong>TapSale</strong></a><button type="button" id="sidebarCollapse" class="sidebar-collapse" aria-label="Menü einklappen" title="Menü einklappen">‹</button></div>
<nav><a asp-page="/Sale/Index"><span>@T["Sell"]</span></a><a asp-page="/History/Index"><span>@T["History"]</span></a>
@if (Current.IsManager) { <a asp-page="/Admin/SaleLists/Index"><span>@T["SaleLists"]</span></a> }
@if (Current.IsAdmin) { <a asp-page="/Admin/Users/Index"><span>@T["Users"]</span></a> }
@if (Current.IsAdmin) { <a asp-page="/Admin/Appearance/Index"><span>@T["Appearance"]</span></a> }
</nav><div class="sidebar-bottom"><form method="post" asp-page="/Account/Language" class="language-switch"><input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString"/><button name="language" value="de">DE</button><button name="language" value="en">EN</button></form><div class="user-chip"><span class="avatar">@Current.Name.FirstOrDefault()</span><span><strong>@Current.Name</strong><small>@Current.Role</small></span></div>
<form method="post" asp-page="/Account/Logout"><button class="nav-button" type="submit">@T["Logout"]</button></form></div></aside>
<button type="button" id="sidebarBackdrop" class="sidebar-backdrop" aria-label="Menü schließen" tabindex="-1"></button>
<button type="button" id="sidebarReopen" class="sidebar-reopen" aria-label="Menü öffnen" title="Menü öffnen">☰</button>
<section class="main"><header class="mobile-header"><button type="button" id="menuToggle" aria-label="Menu">☰</button><span class="mobile-brand"><img src="~/icons/app-icon.svg" alt=""/><strong>TapSale</strong></span><span id="networkDot" class="network-dot"></span></header>
<main class="content">@RenderBody()</main></section></div>
<script src="~/js/site.js" asp-append-version="true"></script>@await RenderSectionAsync("Scripts", required: false)</body></html>
